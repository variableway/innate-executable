---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buttonVariants } from '@atlas/ui/components/ui/button';
import { useTranslations, type Locale } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'useCases'>;
}

const { locale, entry } = Astro.props;
const t = useTranslations(locale);
const target = entry.data.url!;
---

<BaseLayout title={`Redirect → ${entry.data.title}`} description={entry.data.description}>
  <section class="mx-auto max-w-xl space-y-6 py-16 text-center">
    <p class="text-sm uppercase tracking-wider text-muted-foreground">{t('go.kicker')}</p>
    <h1 class="text-3xl font-bold tracking-tight">{entry.data.title}</h1>
    <p class="text-muted-foreground">{entry.data.description}</p>
    <p class="text-xs text-muted-foreground">{t('go.redirecting')} <code class="rounded bg-muted px-1 py-0.5">{target}</code> <span id="countdown">3</span>s…</p>
    <div class="flex justify-center gap-3 pt-2">
      <a href={target} target="_blank" rel="noreferrer" class={buttonVariants()}>{t('go.openNow')}</a>
      <a href={localePath(locale, '/use-cases')} class={buttonVariants({ variant: 'outline' })}>{t('go.back')}</a>
    </div>
  </section>

  <script is:inline set:html={`
    (function () {
      var i = 3;
      var el = document.getElementById('countdown');
      var t = setInterval(function () {
        i--;
        if (el) el.textContent = String(Math.max(0, i));
        if (i <= 0) {
          clearInterval(t);
          window.location.href = ${JSON.stringify(target)};
        }
      }, 1000);
    })();
  `} />
</BaseLayout>
