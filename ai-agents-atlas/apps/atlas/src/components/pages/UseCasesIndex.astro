---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@atlas/ui/components/ui/card';
import { Badge } from '@atlas/ui/components/ui/badge';
import { frameworkMeta } from '@/lib/frameworks';
import { useTranslations, type Locale } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
import { getLocalizedEntries } from '@/i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const useCases = (await getLocalizedEntries('useCases', locale))
  .sort(
    (a, b) =>
      (b.entry.data.publishedAt?.getTime() ?? 0) - (a.entry.data.publishedAt?.getTime() ?? 0),
  );
---

<BaseLayout title={t('useCases.index.title')} description={t('useCases.index.lede')}>
  <header class="space-y-3 border-b border-border pb-8">
    <p class="text-sm uppercase tracking-wider text-muted-foreground">{t('useCases.kicker')}</p>
    <h1 class="text-4xl font-bold tracking-tight">{t('useCases.index.title')}</h1>
    <p class="max-w-2xl text-lg text-muted-foreground">
      {t('useCases.index.lede')}
    </p>
  </header>

  <section class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {useCases.map((uc) => (
      <Card className="h-full">
        <CardHeader>
          <div class="flex flex-wrap gap-1.5">
            <Badge variant="outline">
              {frameworkMeta[uc.entry.data.framework].name}
            </Badge>
            <Badge variant="secondary">{uc.entry.data.industry}</Badge>
            <Badge variant="secondary">{uc.entry.data.resourceType}</Badge>
          </div>
          <CardTitle className="mt-2">{uc.entry.data.title}</CardTitle>
          <CardDescription>{uc.entry.data.description}</CardDescription>
        </CardHeader>
        <CardContent>
          {uc.entry.data.url ? (
            <a
              href={localePath(locale, `/go/${uc.slug}`)}
              class="text-sm text-primary hover:underline"
              rel="noreferrer"
            >
              {t('useCases.openSource')}
            </a>
          ) : (
            <span class="text-sm text-muted-foreground">{t('useCases.noLink')}</span>
          )}
        </CardContent>
      </Card>
    ))}
  </section>
</BaseLayout>
