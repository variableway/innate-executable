---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Card, CardHeader, CardTitle, CardDescription, CardContent } from '@atlas/ui/components/ui/card';
import { Badge } from '@atlas/ui/components/ui/badge';
import { frameworks, frameworkMeta } from '@/lib/frameworks';
import { formatDate } from '@/lib/utils';
import { LessonsList, type LessonListItem } from '@/components/atlas/lessons-list';
import { useTranslations, type Locale, type UiKey } from '@/i18n/ui';
import { localePath } from '@/i18n/utils';
import { getLocalizedEntries } from '@/i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const dateLocale = locale === 'zh' ? 'zh-CN' : 'en-US';

const lessons = (await getLocalizedEntries('lessons', locale, ({ data }) => !data.draft))
  .sort((a, b) => b.entry.data.publishedAt.getTime() - a.entry.data.publishedAt.getTime());

const byFramework = lessons.reduce((acc, l) => {
  const k = l.entry.data.framework;
  acc[k] = (acc[k] ?? 0) + 1;
  return acc;
}, {} as Record<string, number>);

// Category dimension: lessons grouped per framework, with localized
// group descriptions from the dictionary.
const groups = Object.fromEntries(
  frameworks.map((fw) => [
    fw,
    { name: frameworkMeta[fw].name, description: t(`frameworks.desc.${fw}` as UiKey) },
  ]),
);

const items: LessonListItem[] = lessons.map((lesson) => ({
  slug: lesson.slug,
  title: lesson.entry.data.title,
  description: lesson.entry.data.description,
  framework: lesson.entry.data.framework,
  level: lesson.entry.data.level,
  publishedAt: formatDate(lesson.entry.data.publishedAt, undefined, dateLocale),
  duration: lesson.entry.data.duration,
}));

const listLabels = {
  empty: t('lessons.empty'),
  done: t('lessons.done'),
  minUnit: t('lessons.minUnit'),
  title: t('lessons.filter'),
  search: t('lessons.filter.search'),
  framework: t('lessons.filter.framework'),
  level: t('lessons.filter.level'),
  all: t('lessons.filter.all'),
  reset: t('lessons.filter.reset'),
};
---

<BaseLayout title={t('lessons.index.title')} description={t('lessons.index.lede')}>
  <header class="space-y-3 border-b border-border pb-8">
    <p class="text-sm uppercase tracking-wider text-muted-foreground">{t('lessons.kicker')}</p>
    <h1 class="text-4xl font-bold tracking-tight">{t('lessons.index.title')}</h1>
    <p class="max-w-2xl text-lg text-muted-foreground">
      {t('lessons.index.lede')}
    </p>
    <div class="flex flex-wrap items-center gap-2 pt-2">
      {Object.entries(byFramework).map(([fw, count]) => (
        <Badge variant="outline">
          {frameworkMeta[fw as keyof typeof frameworkMeta]?.name ?? fw} · {count}
        </Badge>
      ))}
      <a
        href={localePath(locale, '/roadmap')}
        class="text-sm font-medium text-primary underline-offset-4 hover:underline"
      >
        {t('lessons.roadmapCta')}
      </a>
    </div>
  </header>

  <noscript>
    <section class="mt-10 space-y-10">
      {frameworks.map((fw) => {
        const groupLessons = lessons.filter((l) => l.entry.data.framework === fw);
        if (groupLessons.length === 0) return null;
        return (
          <div>
            <header class="mb-4 border-b border-border pb-2">
              <h2 class="text-xl font-semibold tracking-tight">{groups[fw].name}</h2>
              <p class="text-sm text-muted-foreground">{groups[fw].description}</p>
            </header>
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {groupLessons.map((lesson) => (
                <a href={localePath(locale, `/lessons/${lesson.slug}`)} class="group">
                  <Card className="h-full transition-colors group-hover:border-primary/40">
                    <CardHeader>
                      <div class="flex flex-wrap gap-1.5">
                        <Badge variant="outline">{frameworkMeta[lesson.entry.data.framework].name}</Badge>
                        <Badge variant="secondary">{lesson.entry.data.level}</Badge>
                      </div>
                      <CardTitle className="mt-2">{lesson.entry.data.title}</CardTitle>
                      <CardDescription>{lesson.entry.data.description}</CardDescription>
                    </CardHeader>
                    <CardContent>
                      <p class="text-xs text-muted-foreground">
                        {formatDate(lesson.entry.data.publishedAt, undefined, dateLocale)} · {lesson.entry.data.duration ?? '—'} {t('lessons.minUnit')}
                      </p>
                    </CardContent>
                  </Card>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </section>
  </noscript>

  <section class="mt-10">
    <LessonsList
      client:load
      items={items}
      labels={listLabels}
      basePath={localePath(locale, '/lessons')}
      grouped
      groups={groups}
    />
  </section>
</BaseLayout>
