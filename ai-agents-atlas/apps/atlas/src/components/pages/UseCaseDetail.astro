---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Badge } from '@atlas/ui/components/ui/badge';
import { Separator } from '@atlas/ui/components/ui/separator';
import { buttonVariants } from '@atlas/ui/components/ui/button';
import { frameworkMeta } from '@/lib/frameworks';
import { useTranslations, type Locale } from '@/i18n/ui';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'useCases'>;
}

const { locale, entry } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);
const meta = entry.data;
---

<BaseLayout title={meta.title} description={meta.description}>
  <article class="mx-auto max-w-4xl space-y-8">
    <header class="space-y-4">
      <p class="text-sm uppercase tracking-wider text-muted-foreground">
        {meta.sourceHeading}
      </p>
      <div class="flex flex-wrap gap-1.5">
        <Badge variant="outline">{frameworkMeta[meta.framework].name}</Badge>
        <Badge variant="secondary">{meta.industry}</Badge>
        <Badge variant="secondary">{meta.resourceType}</Badge>
      </div>
      <h1 class="text-4xl font-bold tracking-tight">{meta.title}</h1>
      <p class="text-lg text-muted-foreground">{meta.description}</p>
      {meta.url && (
        <div class="pt-2">
          <a href={meta.url} target="_blank" rel="noreferrer" class={buttonVariants()}>
            {t('useCases.openProject')}
          </a>
        </div>
      )}
    </header>

    <Separator />

    <section class="prose prose-lg prose-zinc max-w-none dark:prose-invert prose-a:text-primary">
      <Content />
    </section>
  </article>
</BaseLayout>
