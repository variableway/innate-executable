---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Card, CardHeader, CardTitle, CardDescription } from '@atlas/ui/components/ui/card';
import { Badge } from '@atlas/ui/components/ui/badge';
import { frameworkMeta } from '@/lib/frameworks';
import { RoadmapProgress, RoadmapStepDot } from '@/components/atlas/roadmap-progress';
import { getLocalizedEntries } from '@/i18n/content';
import { localePath } from '@/i18n/utils';
import { useTranslations, type Locale } from '@/i18n/ui';

/**
 * Lessons presented as an ordered learning path — the sequential
 * counterpart to the category view on /lessons. Ordering comes from
 * each lesson's `order` frontmatter field (0 = unplaced, pushed to the
 * end by publish date). Shared by both locale shells.
 */

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const lessons = (await getLocalizedEntries('lessons', locale, ({ data }) => !data.draft)).sort(
  (a, b) => {
    const ao = a.entry.data.order || Number.MAX_SAFE_INTEGER;
    const bo = b.entry.data.order || Number.MAX_SAFE_INTEGER;
    if (ao !== bo) return ao - bo;
    return a.entry.data.publishedAt.getTime() - b.entry.data.publishedAt.getTime();
  },
);

const totalMinutes = lessons.reduce((sum, l) => sum + (l.entry.data.duration ?? 0), 0);
const slugs = lessons.map((l) => l.slug);
---

<BaseLayout title={t('roadmap.title')} description={t('roadmap.lede')}>
  <header class="space-y-3 border-b border-border pb-8">
    <p class="text-sm uppercase tracking-wider text-muted-foreground">{t('roadmap.kicker')}</p>
    <h1 class="text-4xl font-bold tracking-tight">{t('roadmap.title')}</h1>
    <p class="max-w-2xl text-lg text-muted-foreground">{t('roadmap.lede')}</p>
    <div class="flex flex-wrap gap-2 pt-2">
      <Badge variant="outline">{lessons.length} {t('roadmap.badge.lessons')}</Badge>
      <Badge variant="secondary">{totalMinutes} {t('roadmap.badge.minutes')}</Badge>
    </div>
    <div class="max-w-md pt-4">
      <RoadmapProgress client:load slugs={slugs} label={t('roadmap.progress')} />
    </div>
  </header>

  <section class="mt-12">
    <ol class="relative ml-[1.125rem] space-y-4 border-l border-border pl-8">
      {lessons.map((lesson, index) => (
        <li class="relative">
          <span class="absolute top-5" style="left: -2.625rem;">
            <RoadmapStepDot client:visible slug={lesson.slug} />
          </span>
          <a href={localePath(locale, `/lessons/${lesson.slug}`)} class="block">
            <Card className="transition-colors hover:border-primary/40">
              <CardHeader>
                <div class="flex items-baseline gap-3">
                  <span class="shrink-0 font-mono text-xs text-muted-foreground">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="space-y-1.5">
                    <div class="flex flex-wrap items-center gap-1.5">
                      <Badge variant="outline">
                        {frameworkMeta[lesson.entry.data.framework].name}
                      </Badge>
                      <Badge variant="secondary">{lesson.entry.data.level}</Badge>
                      {lesson.entry.data.duration && (
                        <span class="text-xs text-muted-foreground">
                          {lesson.entry.data.duration} {t('lessons.minUnit')}
                        </span>
                      )}
                    </div>
                    <CardTitle className="text-base">{lesson.entry.data.title}</CardTitle>
                    <CardDescription>{lesson.entry.data.description}</CardDescription>
                  </div>
                </div>
              </CardHeader>
            </Card>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
