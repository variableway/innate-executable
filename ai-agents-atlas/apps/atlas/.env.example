# Public site URL — required for sitemap and RSS absolute links.
PUBLIC_SITE_URL=https://atlas.example.com

# Plausible analytics (optional).
# When unset the analytics <script> is omitted entirely.
PUBLIC_PLAUSIBLE_DOMAIN=

# Cloudflare Worker endpoint that accepts thumbs-up/down feedback (optional).
# POST application/json { vote: 'up'|'down', path, ts }.
PUBLIC_FEEDBACK_ENDPOINT=

# Giscus (optional). Configure once at https://giscus.app then paste here.
PUBLIC_GISCUS_REPO=
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=General
PUBLIC_GISCUS_CATEGORY_ID=